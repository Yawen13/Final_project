# Copy this file to .env.local and fill in a real key.
# .env.local is git-ignored (*.local) and must never be committed.
#
# Note the missing VITE_ prefix — that is deliberate. Vite inlines VITE_*-
# prefixed variables into the client bundle, which would expose the key to
# anyone who opens devtools. This one is read only by vite.config.js and
# injected as a proxy header on the dev server.
DEEPSEEK_API_KEY=
