# Copy this file to .env.local and fill in a real key.
# .env.local is git-ignored (*.local) and must never be committed.
#
# Note the missing VITE_ prefix — that is deliberate. Vite inlines VITE_*-
# prefixed variables into the client bundle, which would expose the key to
# anyone who opens devtools. This one is read only by vite.config.js and
# injected as a proxy header on the dev server.
DEEPSEEK_API_KEY=

# Base URL of the Unfinished backend (the Express server on the Backend-Monica
# branch), e.g. http://localhost:3000/api — the /api prefix included, every path
# in src/api/ is relative to it. That server runs on port 3000 by default.
#
# Leave it unset to run on placeholder data: login accepts anything and the
# Messages page uses its own store, which is what you want when the backend
# (it needs serviceAccountKey.json, which is not in the repo) is not running.
# Set it and the same pages call the real API instead.
#
# VITE_ prefix is on purpose — unlike DEEPSEEK_API_KEY above, this one is meant
# to be read in the browser.
VITE_API_BASE_URL=

# The messages endpoints (/conversations/...) do not exist on the backend yet,
# so the Messages page stays on its placeholder store even with the URL above
# set. Set this to "on" once those endpoints ship.
VITE_MESSAGES_API=
